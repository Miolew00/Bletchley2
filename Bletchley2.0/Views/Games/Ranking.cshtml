@model List<Bletchley2._0.Models.Game>
@{
    ViewData["Title"] = "Ranking";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">🏆 Leaderboard</h2>
                <a asp-action="Index" class="btn btn-dark">🎮 Play</a>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    No games played yet. Be the first to crack the code!
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-center">Rank</th>
                                    <th>Player</th>
                                    <th class="text-center">Attempts</th>
                                    <th class="text-center">Score</th>
                                    <th class="text-center">Result</th>
                                    <th class="text-center">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var game = Model[i];
                                    <tr class="@(i == 0 ? "table-warning" : i == 1 ? "table-light" : "")">
                                        <td class="text-center fw-bold">
                                            @if (i == 0)
                                            {
                                                <span>🥇</span>
                                            }
                                            else if (i == 1)
                                            {

                                                <span>🥈</span>
                                            }
                                            else if (i == 2)
                                            {

                                                <span>🥉</span>
                                            }
                                            else
                                            {

                                                <span class="text-muted">@(i + 1)</span>
                                            }
                                        </td>
                                        <td class="fw-semibold">@game.User?.UserName</td>
                                        <td class="text-center">
                                            @if (game.IsWon)
                                            {
                                                <span>@game.Attempts</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">13 ❌</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (game.Score >= 20)
                                            {
                                                <span class="badge bg-success fs-6">@game.Score</span>
                                            }
                                            else if (game.Score >= 10)
                                            {
                                                <span class="badge bg-primary fs-6">@game.Score</span>
                                            }
                                            else if (game.Score >= 5)
                                            {
                                                <span class="badge bg-warning text-dark fs-6">@game.Score</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary fs-6">@game.Score</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (game.IsWon)
                                            {
                                                <span class="badge bg-success">Won</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Lost</span>
                                            }
                                        </td>
                                        <td class="text-center text-muted small">
                                            @game.PlayedAt.ToString("dd MMM yyyy")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>