@model Bletchley2._0.Models.Game
@{
    ViewData["Title"] = "Play Mastermind";
    var guesses = ViewBag.Guesses as List<Bletchley2._0.Models.Guess> ?? new List<Bletchley2._0.Models.Guess>();
    var secretNums = Model.SecretCode.Split(' ').Select(int.Parse).ToList();
    int attemptsLeft = 13 - Model.Attempts;
    int progressPercent = Model.Attempts * 100 / 13;
    string progressColor = attemptsLeft <= 3 ? "bg-danger" : attemptsLeft <= 6 ? "bg-warning" : "bg-success";
}

<style>
    .tile {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: bold;
        color: white;
        margin: 3px;
    }

    .tile-green {
        background-color: #538d4e;
    }

    .tile-yellow {
        background-color: #b59f3b;
    }

    .tile-red {
        background-color: #c0392b;
    }

    .tile-future {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 3px;
        border: 2px solid #3a3a3c;
        background-color: #121213;
    }

    .card-dark {
        background-color: #1a1a1b;
        border: 1px solid #3a3a3c;
        border-radius: 12px;
    }

    .form-control-dark {
        background-color: #1a1a1b !important;
        border: 2px solid #3a3a3c !important;
        color: white !important;
        text-align: center;
        font-size: 1.8rem;
        letter-spacing: 12px;
        border-radius: 8px;
    }

        .form-control-dark:focus {
            border-color: #538d4e !important;
            box-shadow: 0 0 0 0.2rem rgba(83,141,78,0.3) !important;
        }

        .form-control-dark::placeholder {
            color: #818384;
            letter-spacing: 4px;
            font-size: 1.2rem;
        }

    .btn-green {
        background-color: #538d4e;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        letter-spacing: 2px;
    }

        .btn-green:hover {
            background-color: #6aaf64;
            color: white;
        }

    .attempts-badge {
        background-color: #3a3a3c;
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: bold;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">🔐 Mastermind</h2>
                <span class="attempts-badge">@Model.Attempts / 13</span>
            </div>

            @if (Model.IsCompleted)
            {
                if (Model.IsWon)
                {
                    <div class="alert text-center mb-4" style="background:#538d4e;color:white;border:none;border-radius:12px;">
                        <h4 class="mb-1">🎉 Позна кода!</h4>
                        <p class="mb-1">Решен за <strong>@Model.Attempts</strong> опита</p>
                        <p class="mb-0 fs-5">Точки: <strong>@Model.Score</strong></p>
                    </div>
                }
                else
                {
                    <div class="alert text-center mb-4" style="background:#c0392b;color:white;border:none;border-radius:12px;">
                        <h4 class="mb-1">💥 Game Over!</h4>
                        <p class="mb-1">Тайният код беше:</p>
                        <p class="mb-0 fs-3 fw-bold" style="letter-spacing:10px;">@string.Join(" ", secretNums)</p>
                    </div>
                }

                <div class="d-flex gap-2 mb-4">
                    <a asp-action="Start" class="btn btn-green flex-fill py-2">🎮 Нова игра</a>
                    <a asp-action="Ranking" class="btn flex-fill py-2" style="background:#3a3a3c;color:white;">🏆 Класация</a>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <div class="d-flex justify-content-between small mb-1" style="color:#818384;">
                        <span>Опити използвани</span>
                        <span>Остават: @attemptsLeft</span>
                    </div>
                    <div class="progress" style="height:8px;background:#3a3a3c;border-radius:4px;">
                        <div class="progress-bar @progressColor" style="width:@(progressPercent)%;border-radius:4px;"></div>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert mb-3" style="background:#b59f3b;color:white;border:none;border-radius:8px;">
                        ⚠️ @TempData["Error"]
                    </div>
                }

                <div class="card-dark p-4 mb-4">
                    <p style="color:#818384;" class="mb-3 small">Пиши цифрите — интервалите се добавят автоматично</p>
                    <form method="post" action="/Games/SubmitGuess">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="gameId" value="@Model.Id" />
                        <div class="mb-3">
                            <input type="text"
                                   id="guessInput"
                                   name="guessInput"
                                   class="form-control form-control-lg form-control-dark"
                                   placeholder="_ _ _ _"
                                   maxlength="7"
                                   autocomplete="off"
                                   autofocus
                                   required />
                        </div>
                        <button type="submit" class="btn btn-green btn-lg w-100 py-2">
                            🔍 ПОЗНАЙ
                        </button>
                    </form>
                </div>
            }

            <div class="d-flex justify-content-center gap-3 mb-4">
                <div class="d-flex align-items-center gap-1">
                    <div class="tile tile-green" style="width:28px;height:28px;font-size:.8rem;">■</div>
                    <span style="color:#818384;font-size:.85rem;">Точна позиция</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <div class="tile tile-yellow" style="width:28px;height:28px;font-size:.8rem;">■</div>
                    <span style="color:#818384;font-size:.85rem;">Грешна позиция</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <div class="tile tile-red" style="width:28px;height:28px;font-size:.8rem;">■</div>
                    <span style="color:#818384;font-size:.85rem;">Не е в кода</span>
                </div>
            </div>

            @foreach (var g in guesses.OrderBy(x => x.AttemptNumber))
            {
                var gNums = g.GuessCode.Split(' ').Select(int.Parse).ToList();
                <div class="mb-1">
                    @for (int i = 0; i < 4; i++)
                    {
                        string tileClass;
                        if (gNums[i] == secretNums[i])
                        {
                            tileClass = "tile-green";
                        }
                        else if (secretNums.Contains(gNums[i]))
                        {
                            tileClass = "tile-yellow";
                        }
                        else
                        {
                            tileClass = "tile-red";
                        }
                        <div class="tile @tileClass">@gNums[i]</div>
                    }
                </div>
            }

            @for (int row = guesses.Count; row < 13; row++)
            {
                <div class="mb-1">
                    @for (int col = 0; col < 4; col++)
                    {
                        <div class="tile-future"></div>
                    }
                </div>
            }

        </div>
    </div>
</div>

<script>
    const input = document.getElementById('guessInput');
    if (input) {
        input.addEventListener('input', function () {
            // Запази позицията на курсора
            let pos = this.selectionStart;

            // Вземи само цифрите
            let digits = this.value.replace(/[^0-9]/g, '');

            // Ограничи до 4 цифри
            if (digits.length > 4) {
                digits = digits.substring(0, 4);
            }

            // Добави интервал между цифрите автоматично
            let formatted = digits.split('').join(' ');
            this.value = formatted;

            // Ако са въведени 4 цифри — фокусирай бутона
            if (digits.length === 4) {
                document.querySelector('.btn-green').focus();
            }
        });

        // Enter = submit
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                this.closest('form').submit();
            }
            // Блокирай всичко освен цифри, backspace, delete, стрелки
            const allowed = ['Backspace','Delete','ArrowLeft','ArrowRight','Tab'];
            if (!allowed.includes(e.key) && !/^[0-9]$/.test(e.key)) {
                e.preventDefault();
            }
        });
    }
</script>