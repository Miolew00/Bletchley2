@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-title {
        font-size: 3.5rem;
        font-weight: 900;
        letter-spacing: 3px;
        color: white;
    }

    .hero-sub {
        color: #818384;
        font-size: 1.1rem;
    }

    .home-card {
        background-color: #1a1a2e;
        border: 1px solid #3a3a5c;
        border-radius: 16px;
        padding: 32px;
        height: 100%;
        transition: border-color 0.3s, transform 0.2s;
    }

        .home-card:hover {
            border-color: #7c3aed;
            transform: translateY(-4px);
        }

        .home-card h4 {
            color: white;
            font-weight: 700;
            font-size: 1.3rem;
            margin-bottom: 12px;
        }

        .home-card p {
            color: #818384;
            font-size: 0.95rem;
            line-height: 1.6;
        }

    .card-icon {
        font-size: 2.5rem;
        margin-bottom: 16px;
    }

    .btn-purple {
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 14px 40px;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 1px;
        transition: opacity 0.2s;
        text-decoration: none;
    }

        .btn-purple:hover {
            opacity: 0.85;
            color: white;
        }

    .btn-outline-light-custom {
        background: transparent;
        color: #a78bfa;
        border: 2px solid #3a3a5c;
        border-radius: 10px;
        padding: 14px 40px;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-outline-light-custom:hover {
            border-color: #7c3aed;
            color: white;
        }

    .score-pill {
        border-radius: 8px;
        padding: 10px 0;
        font-weight: 700;
        font-size: 1rem;
        color: white;
        text-align: center;
        flex: 1;
    }

    .divider {
        border-color: #3a3a5c;
        margin: 50px 0;
    }

    .stat-box {
        background-color: #1a1a2e;
        border: 1px solid #3a3a5c;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

        .stat-box .stat-num {
            font-size: 2rem;
            font-weight: 900;
            color: #a78bfa;
        }

        .stat-box .stat-label {
            color: #818384;
            font-size: 0.85rem;
        }
</style>

<div class="py-5 text-center">

    <!-- HERO -->
    <div class="mb-5">
        <div class="hero-title">🔐 MASTERMIND</div>
        <p class="hero-sub mt-2">Разбий тайния код. Спечели точките. Оглави класацията.</p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-controller="Games" asp-action="Start" class="btn-purple">🎮 Играй сега</a>
            <a asp-controller="Games" asp-action="Ranking" class="btn-outline-light-custom">🏆 Класация</a>
        </div>
    </div>

    <hr class="divider" />

    <!-- СТАТИСТИКИ -->
    <div class="row g-3 mb-5 justify-content-center">
        <div class="col-4 col-md-2">
            <div class="stat-box">
                <div class="stat-num">0–7</div>
                <div class="stat-label">Числа в кода</div>
            </div>
        </div>
        <div class="col-4 col-md-2">
            <div class="stat-box">
                <div class="stat-num">4</div>
                <div class="stat-label">Цифри в кода</div>
            </div>
        </div>
        <div class="col-4 col-md-2">
            <div class="stat-box">
                <div class="stat-num">13</div>
                <div class="stat-label">Макс. опита</div>
            </div>
        </div>
        <div class="col-4 col-md-2">
            <div class="stat-box">
                <div class="stat-num">20</div>
                <div class="stat-label">Макс. точки</div>
            </div>
        </div>
    </div>

    <!-- КАРТИ -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="home-card">
                <div class="card-icon">🎯</div>
                <h4>Как се играе</h4>
                <p>Компютърът генерира 4 уникални числа от 0 до 7. Ти трябва да ги познаеш за колкото се може по-малко опити.</p>
                <div class="mt-3 d-flex gap-2">
                    <div style="background:#538d4e;border-radius:6px;padding:6px 10px;color:white;font-size:.8rem;">🟢 Точна позиция</div>
                    <div style="background:#b59f3b;border-radius:6px;padding:6px 10px;color:white;font-size:.8rem;">🟡 Грешна позиция</div>
                    <div style="background:#c0392b;border-radius:6px;padding:6px 10px;color:white;font-size:.8rem;">🔴 Не е в кода</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="home-card">
                <div class="card-icon">🏆</div>
                <h4>Точкова система</h4>
                <p>Колкото по-малко опити използваш, толкова повече точки получаваш!</p>
                <div class="d-flex gap-2 mt-3">
                    <div class="score-pill" style="background:#538d4e;">20 т<br /><small style="font-weight:400;font-size:.75rem;">1–3 опита</small></div>
                    <div class="score-pill" style="background:#1d4ed8;">10 т<br /><small style="font-weight:400;font-size:.75rem;">4–7 опита</small></div>
                    <div class="score-pill" style="background:#b59f3b;">5 т<br /><small style="font-weight:400;font-size:.75rem;">8–10 опита</small></div>
                    <div class="score-pill" style="background:#4a4a4a;">3 т<br /><small style="font-weight:400;font-size:.75rem;">11–13 опита</small></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="home-card">
                <div class="card-icon">⚡</div>
                <h4>Класация</h4>
                <p>Всяка завършена игра се записва. Оглави глобалната класация и покажи кой е истинският Mastermind!</p>
                <a asp-controller="Games" asp-action="Ranking" class="btn-outline-light-custom d-inline-block mt-3" style="padding:10px 24px;font-size:.9rem;">
                    Виж класацията →
                </a>
            </div>
        </div>

    </div>

    <!-- CTA -->
    <div style="background:linear-gradient(135deg,#3b0086,#6a0dad);border-radius:20px;padding:50px 30px;">
        <h3 style="color:white;font-weight:800;font-size:1.8rem;">Готов ли си да разбиеш кода?</h3>
        <p style="color:rgba(255,255,255,0.7);margin-bottom:24px;">Регистрирай се и започни да играеш веднага!</p>
        <a asp-controller="Games" asp-action="Start" class="btn-purple" style="font-size:1.2rem;padding:16px 50px;">
            🎮 Започни играта
        </a>
    </div>

</div>